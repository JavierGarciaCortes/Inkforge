---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<a href={href} class="back">← {label}</a>

<style>
  .back {
    display: inline-flex; align-items: center; gap: .4rem;
    color: var(--accent); font-size: var(--fs-small); margin-bottom: 1rem;
    border: 1px solid var(--border); background: var(--surface);
    padding: .35rem .8rem; border-radius: 6px; transition: .15s;
    text-decoration: none;
  }
  .back:hover { background: var(--surface2); text-decoration: none; }
</style>
