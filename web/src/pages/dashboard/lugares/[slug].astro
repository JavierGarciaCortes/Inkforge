---
import Dashboard from "../../../layouts/Dashboard.astro";
import BackLink from "../../../components/BackLink.astro";
import MdContent from "../../../components/MdContent.astro";
import { getPlaceBySlug, getConfig } from "../../../lib/vault";
import { renderMd, buildSlugMap } from "../../../lib/markdown";

const { slug } = Astro.params;
const place = getPlaceBySlug(slug!);

if (!place) return Astro.redirect("/dashboard/lugares");

const slugMap = buildSlugMap();
const pageTitle = `${place.name} — ${getConfig().title}`;
---

<Dashboard title={pageTitle} section="lugares">
  <BackLink href="/dashboard/lugares" label="Volver a lugares" />
  <h2>{place.name}</h2>
  <div class="sub">{place.type}</div>

  <MdContent content={place.content} slugMap={slugMap} />
</Dashboard>

<style>
  h2 { font-size: var(--fs-h2d); margin: .25rem 0 .15rem; color: var(--heading); }
  .sub { font-size: .9rem; color: var(--text2); margin-bottom: 1.5rem; }
</style>
