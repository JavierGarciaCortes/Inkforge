---
import Dashboard from "../../../layouts/Dashboard.astro";
import BackLink from "../../../components/BackLink.astro";
import { getCharacterBySlug, getConfig } from "../../../lib/vault";
import { renderMd, buildSlugMap } from "../../../lib/markdown";

const { slug } = Astro.params;
const char = getCharacterBySlug(slug!);

if (!char) return Astro.redirect("/dashboard/personajes");

const slugMap = buildSlugMap();
---

<Dashboard title={`${char.name} — ${getConfig().title}`} section="personajes">
  <BackLink href="/dashboard/personajes" label="Volver a personajes" />
  <h2>{char.name}</h2>
  <div class="sub">{char.role}</div>

  {Object.entries(char.detail).map(([key, val]) => (
    <div class="md-content" style="margin-bottom:.75rem">
      <h3>{key.charAt(0).toUpperCase() + key.slice(1)}</h3>
      <div set:html={renderMd(val, slugMap)} />
    </div>
  ))}

</Dashboard>

<style>
  h2 { font-size: var(--fs-h2d); margin: .25rem 0 .15rem; color: var(--heading); }
  .sub { font-size: .9rem; color: var(--text2); margin-bottom: 1.5rem; }
</style>
